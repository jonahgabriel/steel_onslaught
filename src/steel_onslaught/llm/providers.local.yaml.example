# Local endpoint overlay — EXAMPLE (committed). Copy to providers.local.yaml
# (gitignored) and replace the placeholder hosts with your real addresses.
#
# This file supplies endpoint_url values for providers that declare NO
# endpoint_url in the committed providers.yaml (private LAN / Tailscale / lab
# servers), keyed by provider_id under `endpoints`. A provider that declares no
# endpoint_url and has no entry here FAILS CLOSED when requested — the loader
# raises and names this file. Only override providers that exist in
# providers.yaml and declare no committed endpoint_url; any other key is
# rejected. Each URL is the COMPLETE chat-completions endpoint, posted verbatim.
endpoints:
  qwen35: "http://<tailscale-host>:8000/v1/chat/completions"
  qwen27: "http://<tailscale-host>:8001/v1/chat/completions"
  deepseek: "http://<tailscale-host>:8101/v1/chat/completions"
